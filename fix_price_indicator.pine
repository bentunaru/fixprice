//@version=6
indicator("CME Fix Price Indicator", overlay=true)

// ============================================================================
// INPUTS - Configuration des paramètres
// ============================================================================

// Seuils de limite de prix (en pourcentage par rapport au prix de référence)
limit_level_1 = input.float(7.0, "Niveau 1 Limite (%)", minval=0.1, step=0.1, group="Limites de Prix")
limit_level_2 = input.float(13.0, "Niveau 2 Limite (%)", minval=0.1, step=0.1, group="Limites de Prix")
limit_level_3 = input.float(20.0, "Niveau 3 Limite (%)", minval=0.1, step=0.1, group="Limites de Prix")

// Source de prix de référence
reference_source = input.string("Previous Close", "Prix de Référence",
     options=["Previous Close", "Session Open", "Custom"], group="Configuration")
custom_reference = input.float(0.0, "Prix de Référence Personnalisé", group="Configuration")

// Options d'affichage
show_level_1 = input.bool(true, "Afficher Niveau 1", group="Affichage")
show_level_2 = input.bool(true, "Afficher Niveau 2", group="Affichage")
show_level_3 = input.bool(true, "Afficher Niveau 3", group="Affichage")
show_labels = input.bool(true, "Afficher Étiquettes", group="Affichage")
line_width = input.int(2, "Épaisseur Ligne", minval=1, maxval=5, group="Affichage")

// Couleurs
color_level_1 = input.color(color.new(color.yellow, 0), "Couleur Niveau 1", group="Couleurs")
color_level_2 = input.color(color.new(color.orange, 0), "Couleur Niveau 2", group="Couleurs")
color_level_3 = input.color(color.new(color.red, 0), "Couleur Niveau 3", group="Couleurs")

// ============================================================================
// CALCUL DU PRIX DE RÉFÉRENCE
// ============================================================================

// Détection du changement de jour (nouvelle session)
var float reference_price = na
var int reference_bar = na

// Obtenir le prix de clôture de la veille ou l'ouverture de la session
is_new_day = ta.change(dayofweek) != 0

if is_new_day or barstate.isfirst
    if reference_source == "Previous Close"
        reference_price := close[1]
    else if reference_source == "Session Open"
        reference_price := open
    else // Custom
        reference_price := custom_reference
    reference_bar := bar_index

// Si pas de prix de référence encore (premier bar), utiliser l'ouverture
if na(reference_price)
    reference_price := open

// ============================================================================
// CALCUL DES NIVEAUX DE LIMITE
// ============================================================================

// Calcul des prix limites (haut et bas)
upper_limit_1 = reference_price * (1 + limit_level_1 / 100)
lower_limit_1 = reference_price * (1 - limit_level_1 / 100)

upper_limit_2 = reference_price * (1 + limit_level_2 / 100)
lower_limit_2 = reference_price * (1 - limit_level_2 / 100)

upper_limit_3 = reference_price * (1 + limit_level_3 / 100)
lower_limit_3 = reference_price * (1 - limit_level_3 / 100)

// ============================================================================
// DÉTECTION DES ÉVÉNEMENTS FIX PRICE
// ============================================================================

// Variables pour suivre les événements de fix price
var float fix_price_level = na
var string fix_price_type = ""
var int fix_price_bar = na

// Vérifier si un niveau de limite a été atteint
bool hit_upper_1 = high >= upper_limit_1 and show_level_1
bool hit_lower_1 = low <= lower_limit_1 and show_level_1

bool hit_upper_2 = high >= upper_limit_2 and show_level_2
bool hit_lower_2 = low <= lower_limit_2 and show_level_2

bool hit_upper_3 = high >= upper_limit_3 and show_level_3
bool hit_lower_3 = low <= lower_limit_3 and show_level_3

// Détecter le niveau le plus élevé atteint (priorité à Level 3 > Level 2 > Level 1)
if hit_upper_3 or hit_lower_3
    fix_price_level := hit_upper_3 ? upper_limit_3 : lower_limit_3
    fix_price_type := "Level 3 " + (hit_upper_3 ? "UP" : "DOWN")
    fix_price_bar := bar_index
else if hit_upper_2 or hit_lower_2
    fix_price_level := hit_upper_2 ? upper_limit_2 : lower_limit_2
    fix_price_type := "Level 2 " + (hit_upper_2 ? "UP" : "DOWN")
    fix_price_bar := bar_index
else if hit_upper_1 or hit_lower_1
    fix_price_level := hit_upper_1 ? upper_limit_1 : lower_limit_1
    fix_price_type := "Level 1 " + (hit_upper_1 ? "UP" : "DOWN")
    fix_price_bar := bar_index

// Réinitialiser lors d'un nouveau jour
if is_new_day
    fix_price_level := na
    fix_price_type := ""
    fix_price_bar := na

// ============================================================================
// AFFICHAGE
// ============================================================================

// Tracer le prix de référence
plot(reference_price, "Prix de Référence", color=color.new(color.blue, 70), linewidth=1, style=plot.style_line)

// Tracer les niveaux de limite (en pointillés)
plot(show_level_1 ? upper_limit_1 : na, "Limite Haute Niv.1", color=color.new(color_level_1, 70), linewidth=1, style=plot.style_linebr)
plot(show_level_1 ? lower_limit_1 : na, "Limite Basse Niv.1", color=color.new(color_level_1, 70), linewidth=1, style=plot.style_linebr)

plot(show_level_2 ? upper_limit_2 : na, "Limite Haute Niv.2", color=color.new(color_level_2, 70), linewidth=1, style=plot.style_linebr)
plot(show_level_2 ? lower_limit_2 : na, "Limite Basse Niv.2", color=color.new(color_level_2, 70), linewidth=1, style=plot.style_linebr)

plot(show_level_3 ? upper_limit_3 : na, "Limite Haute Niv.3", color=color.new(color_level_3, 70), linewidth=1, style=plot.style_linebr)
plot(show_level_3 ? lower_limit_3 : na, "Limite Basse Niv.3", color=color.new(color_level_3, 70), linewidth=1, style=plot.style_linebr)

// Tracer la ligne de fix price quand un niveau est atteint
var line fix_price_line = na
var label fix_price_label = na

if not na(fix_price_level) and bar_index == fix_price_bar
    // Supprimer l'ancienne ligne et label
    if not na(fix_price_line)
        line.delete(fix_price_line)
    if not na(fix_price_label)
        label.delete(fix_price_label)

    // Déterminer la couleur selon le niveau
    line_color = color_level_1
    if str.contains(fix_price_type, "Level 3")
        line_color := color_level_3
    else if str.contains(fix_price_type, "Level 2")
        line_color := color_level_2

    // Créer une nouvelle ligne horizontale au prix de fix
    fix_price_line := line.new(
         x1=fix_price_bar,
         y1=fix_price_level,
         x2=fix_price_bar + 20,
         y2=fix_price_level,
         color=line_color,
         width=line_width,
         extend=extend.right,
         style=line.style_solid
     )

    // Créer un label si activé
    if show_labels
        label_text = "FIX PRICE\n" + fix_price_type + "\n" + str.tostring(fix_price_level, format.mintick)
        fix_price_label := label.new(
             x=fix_price_bar,
             y=fix_price_level,
             text=label_text,
             color=line_color,
             textcolor=color.white,
             style=label.style_label_left,
             size=size.normal
         )

// ============================================================================
// ALERTES
// ============================================================================

// Conditions d'alerte
alertcondition(hit_upper_1 or hit_lower_1, "Fix Price Level 1", "Limite de prix Niveau 1 atteinte!")
alertcondition(hit_upper_2 or hit_lower_2, "Fix Price Level 2", "Limite de prix Niveau 2 atteinte!")
alertcondition(hit_upper_3 or hit_lower_3, "Fix Price Level 3", "Limite de prix Niveau 3 atteinte!")

// Alerte générale
alertcondition(hit_upper_1 or hit_lower_1 or hit_upper_2 or hit_lower_2 or hit_upper_3 or hit_lower_3,
     "Fix Price Triggered", "Un niveau de fix price a été atteint!")
